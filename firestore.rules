rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /accounts/{accountId} {
      allow read: if true;
      allow write: if true;
    }
    match /wallet_transactions/{txId} {
      allow read: if true;
      allow write: if true;
    }
    match /admin_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }
    match /usernames/{username} {
      allow read: if true;
      allow write: if true;
    }
    match /chat_blocks/{blockId} {
      allow read: if true;
      allow write: if true;
    }
    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if true;
      match /messages/{messageId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}

